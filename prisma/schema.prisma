// Baba 英语 数据模型
// W1: 6 张核心表 — User / Drama / Episode / Dialogue / Word / UserVocabulary

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 内容侧 ─────────────────────────────────────────

enum DramaType {
  DRAMA   // 剧集（多季多集）
  MOVIE   // 单部电影
  TED     // TED 演讲
  CARTOON // 动画
}

model Drama {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  type        DramaType
  titleEn     String
  titleZh     String?
  posterUrl   String?
  description String?   @db.Text
  genres      String[]
  year        Int?
  createdAt   DateTime  @default(now())

  episodes Episode[]

  @@index([type])
}

model Episode {
  id            Int      @id @default(autoincrement())
  dramaId       Int
  seasonNumber  Int      @default(1)
  episodeNumber Int
  code          String   // 如 S01E01
  title         String?
  videoUrl      String   // 服务器路径或 CDN URL
  durationMs    Int?
  createdAt     DateTime @default(now())

  drama     Drama             @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  dialogues Dialogue[]
  progress  EpisodeProgress[]

  @@unique([dramaId, code])
  @@index([dramaId, seasonNumber, episodeNumber])
}

model Dialogue {
  id        Int     @id @default(autoincrement())
  episodeId Int
  index     Int     // 0-based 句子序号
  startMs   Int
  endMs     Int
  enText    String  @db.Text
  zhText    String? @db.Text
  clipUrl   String? // 单句切片 mp4（可选，否则用主视频 seek）

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, index])
  @@index([episodeId])
}

// ─── 词典 ──────────────────────────────────────────

model Word {
  lemma       String  @id // 词形还原后的基本形
  ipa         String?
  definitions Json    // [{"pos":"n.","def":"爸爸"}, ...]
  audioUrl    String?
  freq        Int?    // 词频排名（小=高频）

  vocabulary UserVocabulary[]
}

/// 词源数据（来自 etymonline.com，via yosevu/etymonline GitHub repo, 46k 词）
model WordEtymology {
  lemma      String   @id
  pos        String?
  etymology  String   @db.Text
  years      Int[]
  crossrefs  String[]
}

// ─── 用户侧 ────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  // 手机号是主登录字段；email 保留为可选辅助（用户给的"邮箱注册"不删）
  phone        String?   @unique
  email        String?   @unique
  passwordHash String?
  name         String?
  // 付费有效期；null = 试用 / 未付费
  paidUntil    DateTime?
  createdAt    DateTime  @default(now())

  vocabulary UserVocabulary[]
  progress   EpisodeProgress[]
  wxOrders   WxOrder[]
  yxlDocs    YxlDoc[]
  yxlFiles   YxlFile[]
}

// 短信验证码（注册 / 登录 / 找回密码 共用）
model SmsCode {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  // new / used / expired
  used      Boolean  @default(false)
  expireAt  DateTime
  createdAt DateTime @default(now())

  @@index([phone, code])
  @@index([phone, createdAt])
}

// 微信支付 NATIVE 订单
model WxOrder {
  id            String    @id @default(cuid()) // 商户订单号 out_trade_no
  userId        String
  amountFen     Int       // 金额（分）
  planCode      String    // monthly / quarterly / yearly
  description   String
  prepayId      String?
  codeUrl       String?   // 微信返回的扫码内容
  // pending / paid / canceled / failed
  status        String    @default("pending")
  transactionId String?   // 微信支付流水号
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model EpisodeProgress {
  id             Int      @id @default(autoincrement())
  userId         String
  episodeId      Int
  lastIdx        Int      @default(0)   // 最后看到的句子序号
  lastTimeMs     Int      @default(0)   // 视频精确时间（ms）
  totalWatchedMs Int      @default(0)   // 累计观看时长（ms，去除 seek/pause）
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId])
}

model UserVocabulary {
  id               Int      @id @default(autoincrement())
  userId           String
  wordLemma        String
  addedAt          DateTime @default(now())
  sourceDialogueId Int?
  status           String   @default("new") // new / learning / known

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordLemma], references: [lemma])

  @@unique([userId, wordLemma])
  @@index([userId])
}

// ─── 研习录 ────────────────────────────────────────
// 研习录（网站首页）的个人记录：进度、批注、足迹、阅读进度、划线……
// 一类记录一个 coll（progress / notes / journal / reading / marks / mybooks / domains ...），
// 一条记录一个 docId，内容原样存成 JSON，和研习录前端的数据结构一一对应。
model YxlDoc {
  userId    String
  coll      String
  docId     String
  data      Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, coll, docId])
  @@index([userId, updatedAt])
}

// 研习录书架上挂的电子书（PDF / EPUB）。文件存在服务器磁盘 YXL_FILES_DIR 下，只有本人能读。
model YxlFile {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String
  size      Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
